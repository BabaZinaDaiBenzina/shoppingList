// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // ✅ Исправлено: убран нестандартный output path
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  username       String         @unique
  passwordHash   String
  name           String?
  role           String         @default("user")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  shoppingLists ShoppingList[]
  sharedLists    ListShare[]
  recipes        Recipe[]
  sharedRecipes  RecipeShare[]
  refreshTokens  RefreshToken[]
  templates      Template[]

  @@index([email])
}

model ShoppingList {
  id        String       @id @default(cuid())
  name      String
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares    ListShare[]
  items     Item[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([updatedAt])
}

model ListShare {
  id            String        @id @default(cuid())
  listId        String
  list          ShoppingList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@unique([listId, userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  icon        String?   // Emoji or icon for UI display
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  name        String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  unit        String?   // Default unit: "шт", "кг", "л", "г", etc.
  items       Item[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([categoryId, name])
}

model Item {
  id           String        @id @default(cuid())
  name         String        // Custom name or fallback if product is null
  quantity     Int           @default(1)
  unit         String?       // Override unit from product: "шт", "кг", "г", "л", etc.
  purchased    Boolean       @default(false)
  listId       String
  list         ShoppingList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId    String?       // Optional reference to Product catalog
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([listId])
  @@index([purchased])
}

model Recipe {
  id           String        @id @default(cuid())
  title        String
  description  String?
  ingredients  String
  instructions String?
  cookingTime  Int?
  servings     Int?
  category     RecipeCategory @default(OTHER)
  isFavorite   Boolean       @default(false)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares       RecipeShare[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model RecipeShare {
  id            String        @id @default(cuid())
  recipeId      String
  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@unique([recipeId, userId])
}

enum RecipeCategory {
  BREAKFAST    // Завтрак
  LUNCH        // Обед
  DINNER       // Ужин
  SNACK        // Закуска
  SOUP         // Суп
  SALAD        // Салат
  MAIN_COURSE  // Основное блюдо
  DESSERT      // Десерт
  DRINK        // Напиток
  BAKING       // Выпечка
  PRESERVES    // Заготовки
  OTHER        // Другое
}

model Template {
  id          String          @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean         @default(false) // Публичные шаблоны доступны всем
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       TemplateItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([isPublic])
  @@unique([userId, name])
}

model TemplateItem {
  id         String   @id @default(cuid())
  name       String
  quantity   Int      @default(1)
  unit       String?
  productId  String?  // Optional reference to Product catalog
  categoryId String?  // For better organization
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([templateId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}
