# Локальная разработка - SQLite
DATABASE_URL="file:./dev.db"

# JWT Secret - ОБЯЗАТЕЛЬНО измените в продакшене!
# Сгенерируйте с помощью: openssl rand -base64 32
# Минимум 32 символа для безопасности
JWT_SECRET="change-this-to-a-secure-random-string-min-32-chars-long"

# CSRF защита
# Отключите только для локальной разработки (не рекомендуется)
# DISABLE_CSRF="true"

# Настройки PostgreSQL (для продакшена через Docker)
# POSTGRES_USER="shoppinglist"
# POSTGRES_PASSWORD=""
# POSTGRES_DB="shoppinglist"

# Порт приложения
PORT=3000
